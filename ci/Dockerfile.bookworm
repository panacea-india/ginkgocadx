# Build environment: Debian 12 (bookworm) distribution libraries.
#
# wxWidgets 3.2, ITK 5, DCMTK 3.6.7, OpenSSL 3 and VTK 9.1 all come from Debian.
# The widget drawing code still uses legacy OpenGL calls; the application asks
# for a compatibility-profile context so they keep working next to VTK 9 (see
# docs/modernization-plan.md, Phase 2).
FROM --platform=linux/amd64 debian:bookworm

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      pkg-config \
      libcairo2-dev \
      libcurl4-gnutls-dev \
      libdcmtk-dev \
      libfftw3-dev \
      libfreetype6-dev \
      libgdcm-tools \
      libgl-dev \
      libglu1-mesa-dev \
      libgtk-3-dev \
      libinsighttoolkit5-dev \
      libjsoncpp-dev \
      default-libmysqlclient-dev \
      libsqlite3-dev \
      libssl-dev \
      libvtk9-dev \
      libwrap0-dev \
      libwxgtk3.2-dev \
      libxml2-dev \
      librsvg2-common \
      locales \
 && sed -i 's/^# *\(en_US.UTF-8\)/\1/' /etc/locale.gen \
 && locale-gen \
 && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8
# No D-Bus session in the container; keep GTK settings in memory instead of
# printing a dconf warning for every change.
ENV GSETTINGS_BACKEND=memory

WORKDIR /src
